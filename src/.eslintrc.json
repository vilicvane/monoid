{
  "root": true,
  "overrides": [
    {
      "files": ["**/*.{ts,tsx}"],
      "extends": ["plugin:@mufan/typescript", "plugin:@mufan/react"],
      "settings": {
        "import/external-module-folders": [
          "node_modules",
          "plugins/keyboard",
          "plugins/biometric-vault",
          "plugins/isodep-nfc",
          "plugins/qr-scanner"
        ]
      },
      "parserOptions": {
        "project": "tsconfig.json"
      }
    }
  ]
}
