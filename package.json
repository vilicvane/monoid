{
  "name": "monoid-app",
  "private": true,
  "version": "0.0.1",
  "description": "Mobile companion app for Monoid smart cards: keys, wallets, WalletConnect, security key and OTP on a card you can hold.",
  "homepage": "https://monoid.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/vilicvane/monoid.git"
  },
  "bugs": "https://github.com/vilicvane/monoid/issues",
  "license": "MIT",
  "author": "vilicvane",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "3": "npm install && npm dedupe && npm install",
    "update:ssh-protocol": "node scripts/update-ssh-protocol.mjs",
    "postinstall": "npm --prefix plugins/isodep-nfc run build && npm --prefix plugins/biometric-vault run build && npm --prefix plugins/qr-scanner run build",
    "prepare:applets": "node scripts/prepare-applets.mjs ../monoid-javacard/build/javacard && prettier --write src/@lib/monoid/@applet-bundle.ts src/@assets/applets/manifest.json",
    "build": "rimraf ./.bld && tsc --build",
    "build:web": "npm run prepare:applets && npm run build && vite build",
    "dev": "vite",
    "lint": "node scripts/lint.mjs",
    "lint-prettier": "prettier --check .",
    "test": "npm run lint-prettier && npm run build && npm run lint && npm run test:app",
    "test:app": "node --experimental-test-module-mocks --test \"tests/*.test.mjs\"",
    "android": "npm run prepare:applets && ionic cap run android --livereload --external",
    "ionic:build": "npm run build:web",
    "ios": "npm run ios:sync && cap open ios",
    "ios:sync": "npm run build:web && cap sync ios",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/app-launcher": "8.0.1",
    "@capacitor/clipboard": "8.0.1",
    "@capacitor/core": "8.5.3",
    "@capacitor/dialog": "8.0.1",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/keyboard": "file:plugins/keyboard",
    "@capacitor/status-bar": "8.0.4",
    "@codama/dynamic-codecs": "1.3.0",
    "@codama/nodes": "1.11.0",
    "@codama/nodes-from-anchor": "1.5.6",
    "@codama/visitors-core": "1.11.0",
    "@ionic/react": "^8.6.5",
    "@ionic/react-router": "^8.6.5",
    "@ionic/storage": "^4.0.0",
    "@monoid/ssh-protocol": "file:vendor/monoid-ssh-protocol-0.1.0.tgz",
    "@noble/curves": "1.9.7",
    "@reown/walletkit": "1.6.0",
    "@scure/base": "1.2.6",
    "@scure/btc-signer": "2.4.1",
    "@solana/transaction-messages": "8.5.0",
    "@solana/transactions": "8.5.0",
    "@types/ms": "^2.1.0",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "@walletconnect/core": "2.25.0",
    "@walletconnect/utils": "2.25.0",
    "@web3icons/common": "0.11.53",
    "@web3icons/core": "4.0.58",
    "capacitor-biometric-vault": "file:plugins/biometric-vault",
    "capacitor-isodep-nfc": "file:plugins/isodep-nfc",
    "capacitor-qr-scanner": "file:plugins/qr-scanner",
    "cbor2": "^2.0.1",
    "classnames": "^2.5.1",
    "crypto-js": "4.2.0",
    "entrance-decorator": "^0.4.0",
    "ethers": "^6.15.0",
    "jotai": "^2.12.5",
    "lucide-react": "^1.59.0",
    "mobx": "^6.13.7",
    "mobx-react-lite": "^4.1.0",
    "ms": "^2.1.3",
    "qrcode.react": "4.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router": "^5.3.4",
    "react-router-dom": "^5.3.4",
    "routra": "^0.2.0-alpha.15",
    "routra-react": "^0.2.0-alpha.15",
    "styled-components": "^6.1.19",
    "tslang": "^0.1.27",
    "tslib": "^2.8.1",
    "unmount-animation-clone": "^0.2.0",
    "x-value": "^0.2.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@ionic/cli": "^7.2.1",
    "@mufan/eslint-plugin": "^0.2.19",
    "@solana/addresses": "8.5.0",
    "@types/crypto-js": "4.2.2",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-legacy": "^7.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@walletconnect/sign-client": "2.25.0",
    "eslint": "^8.57.1",
    "fflate": "0.8.3",
    "prettier": "^3.6.2",
    "rimraf": "^5.0.10",
    "run-in-every": "^0.2.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.6"
  }
}
