{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monoid-authority",
  "account_id": "ca460ca2dd53b5a2335003df88d0db8f",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-19",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none",
  },
  "routes": [
    {"pattern": "www.monoid.app/api/authority/*", "zone_name": "monoid.app"},
  ],
  "vars": {
    "AUTHORITY_URL": "https://www.monoid.app/api/authority",
    "GITHUB_CLIENT_ID": "",
    "REOWN_PROJECT_ID": "db10694c682f513cc020fe1937646807",
    "REOWN_AUTH_ORIGINS": "[\"https://www.monoid.app\"]",
    "APP_REDIRECT_URIS": "[\"app.monoid://authority/callback\",\"https://www.monoid.app/authority\"]",
    "APP_ORIGINS": "[\"capacitor://localhost\",\"https://localhost\",\"http://localhost\"]",
  },
  "durable_objects": {
    "bindings": [{"name": "AUTHORITY_STATE", "class_name": "AuthorityState"}],
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["AuthorityState"]}],
  "ratelimits": [
    {
      "name": "REQUEST_LIMIT",
      "namespace_id": "1002",
      "simple": {"limit": 30, "period": 60},
    },
  ],
  "observability": {"enabled": false},
}
