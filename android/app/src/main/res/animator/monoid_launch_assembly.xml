    android:propertyName="translateX"
    android:valueFrom="0" android:valueTo="10" android:valueType="floatType"
    android:startOffset="@integer/monoid_launch_approach_start"
    android:duration="@integer/monoid_launch_approach_duration"
    android:interpolator="@interpolator/monoid_launch_approach" />
