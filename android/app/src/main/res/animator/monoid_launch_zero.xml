<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android" android:ordering="together">
    <objectAnimator
        android:propertyName="rotation"
        android:valueFrom="0" android:valueTo="-90" android:valueType="floatType"
        android:duration="@integer/monoid_launch_rotation_duration"
        android:interpolator="@android:interpolator/fast_out_slow_in" />
    <!-- Spread in 640 ms; rotation ends at 640 ms. Hold 200 ms, then approach at 840 ms. -->
    <objectAnimator
        android:duration="@integer/monoid_launch_animation_duration"
        android:interpolator="@android:interpolator/linear">
        <propertyValuesHolder android:propertyName="translateX" android:valueType="floatType">
            <keyframe android:fraction="0" android:value="0" />
            <keyframe android:fraction="0.551724138" android:value="0"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
            <keyframe android:fraction="0.724137931" android:value="0" />
            <keyframe android:fraction="1" android:value="-50"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </propertyValuesHolder>
    </objectAnimator>
</set>
