{
  "root": true,
  "ignorePatterns": [
    "node_modules/",
    "/src/",
    "/dist/",
    "/android/",
    "/ios/",
    "/plugins/keyboard/"
  ],
  "extends": ["plugin:@mufan/javascript"],
  "overrides": [
    {
      "files": "**/*.{js,mjs}",
      "parserOptions": {
        "sourceType": "module"
      }
    },
    {
      "files": "**/*.cjs",
      "parserOptions": {
        "sourceType": "script"
      }
    },
    {
      "files": ["scripts/**/*.mjs", "tests/**/*.test.mjs"],
      "rules": {
        "import/no-extraneous-dependencies": [
          "error",
          {"devDependencies": true}
        ]
      }
    },
    {
      "files": ["vite.config.ts", "capacitor.config.ts"],
      "extends": ["plugin:@mufan/typescript", "plugin:@mufan/dev"]
    }
  ]
}
