{
  "root": true,
  "ignorePatterns": [
    "node_modules/",
    "/src/",
    "/dist/",
    "/android/",
    "/ios/",
    "/vite.config.js",
    "/capacitor.config.js",
    "/plugins/",
    "/workers/"
  ],
  "extends": ["plugin:@mufan/javascript"],
  "overrides": [
    {
      "files": "**/*.{js,mjs}",
      "env": {"es2022": true},
      "parserOptions": {
        "sourceType": "module"
      }
    },
    {
      "files": "**/*.cjs",
      "parserOptions": {
        "sourceType": "script"
      }
    },
    {
      "files": ["scripts/**/*.mjs", "tests/**/*.test.mjs"],
      "rules": {
        "import/no-extraneous-dependencies": [
          "error",
          {"devDependencies": true}
        ]
      }
    },
    {
      "files": ["tests/**/*.test.mjs"],
      "rules": {
        "@mufan/import": "off",
        "@mufan/scoped-modules": "off"
      }
    },
    {
      "files": ["vite.config.ts", "capacitor.config.ts"],
      "extends": ["plugin:@mufan/typescript", "plugin:@mufan/dev"],
      "parserOptions": {"project": "tsconfig.node.json"}
    }
  ]
}
