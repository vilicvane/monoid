{
  "root": true,
  "ignorePatterns": ["node_modules/", "/src/", "/dist/", "/android/", "/ios/"],
  "extends": ["plugin:@mufan/javascript"],
  "overrides": [
    {
      "files": "**/*.{js,mjs}",
      "parserOptions": {
        "sourceType": "module"
      }
    },
    {
      "files": "**/*.cjs",
      "parserOptions": {
        "sourceType": "script"
      }
    },
    {
      "files": ["vite.config.ts", "capacitor.config.ts"],
      "extends": ["plugin:@mufan/typescript", "plugin:@mufan/dev"]
    }
  ]
}
