{
  "compilerOptions": {
    "target": "ES2018",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2018", "ES2020.Promise", "ESNext.Disposable", "DOM"],
    "types": [],
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "dist/esm",
    "newLine": "LF"
  },
  "include": ["src/**/*.ts"]
}
